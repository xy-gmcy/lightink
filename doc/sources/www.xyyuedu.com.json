  "catalog": {
    "list": "@js->function getCatalog(response, url) {\n    let html = Jsoup.parse(response, url)\n    let list = html.select(\"div.mingzhu-main > ul > li > a.text\")\n    if (list.length == 0) {\n        return html.select(\"ul.zhangjie2 > li\").map(chapter => ({\n            name: chapter.selectFirst(\"a\").text(),\n            url: chapter.selectFirst(\"a\").attr(\"href\")\n        }))\n    } else {\n        return list.flatMap(book => {\n            let link = book.absUrl(\"href\")\n            return [\n                { name: book.text() },\n                getCatalog(GET(link, { charset: 'gb2312'}), link)\n            ].flat()\n        })\n    }\n}\nlet lastResponse = responseCache.lastResponse\ngetCatalog(lastResponse.body, lastResponse.url)->end",
    "name": "$.name",
    "chapter": "$.url"
  },
